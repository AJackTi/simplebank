# Copy this file to app.env for local development only.
# Generate a production-quality TOKEN_SYMMETRIC_KEY with: openssl rand -hex 16
# The value below is disposable and must be replaced outside local development.
ENVIRONMENT=development
DB_DRIVER=postgres
DB_SOURCE=postgresql://simplebank:simplebank_dev@localhost:5432/simple_bank?sslmode=disable
MIGRATION_URL=file://db/migration
HTTP_SERVER_ADDRESS=0.0.0.0:8080
GRPC_SERVER_ADDRESS=0.0.0.0:9090
SMTP_SERVER_ADDRESS=localhost:1025
EMAIL_SENDER_NAME=SimpleBank
EMAIL_SENDER_ADDRESS=noreply@simplebank.dev
# SMTP_USERNAME=
# SMTP_PASSWORD=
TOKEN_SYMMETRIC_KEY=local-dev-secret-change-me-00000
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
REDIS_ADDRESS=localhost:6379
